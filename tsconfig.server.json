{
  // Cloudflare Pages Functions (functions/**), shared server helpers (server/**), the shared
  // contracts they import (src/shared/**), the catalog JSON (data/**) and server-side tests (test/**).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["functions", "server", "src/shared", "data/*.json", "test"]
}
